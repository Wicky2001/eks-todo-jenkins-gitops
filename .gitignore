# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment and secret material
.env
.env.*
!.env.example
*.secret.yaml
*.secret.yml
secrets/
# ...except the stacks' secrets/ folders: they only hold ExternalSecrets (pointers to AWS
# Secrets Manager) and Elasticsearch role lists, never a password. Argo CD needs them in Git.
!platform/*/manifests/secrets/

# Kubernetes client and local cluster state
.kube/
kubeconfig
kubeconfig.*

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

